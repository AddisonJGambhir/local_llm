#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLM_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HERMES_PYTHON="/home/addison-gambhir/Desktop/hermes-agent-main/venv/bin/python3"

if [[ -x "$HERMES_PYTHON" ]]; then
    exec "$HERMES_PYTHON" "$LLM_ROOT/src/diagnostics/diagnose_hermes_400.py" "$@"
fi

exec python3 "$LLM_ROOT/src/diagnostics/diagnose_hermes_400.py" "$@"
