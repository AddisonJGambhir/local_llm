#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LLAMA_SERVER_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LLM_ROOT="$(cd "$LLAMA_SERVER_ROOT/.." && pwd)"
MODELS_DIR="$LLAMA_SERVER_ROOT/models"
DEFAULT_PROFILE="$LLAMA_SERVER_ROOT/config/profiles/default.sh"
STATE_HOME="${LLAMA_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/local-llm}"
GENERATED_PROFILE="$STATE_HOME/interactive-profile.sh"
ACTION="restart"

case "${1:-}" in
    "")
        ;;
    --dry-run)
        ACTION="command"
        ;;
    -h|--help)
        echo "Usage: $0 [--dry-run]"
        exit 0
        ;;
    *)
        echo "Unknown argument: $1" >&2
        exit 2
        ;;
esac

BIN_MAINLINE="$LLM_ROOT/llama.cpp/build/bin/llama-server"
BIN_VULKAN="$LLM_ROOT/llama.cpp/build-vulkan/bin/llama-server"

prompt_choice() {
    local prompt="$1" value
    read -r -p "$prompt" value
    printf '%s\n' "$value"
}

prepare_profile_output() {
    mkdir -p "$STATE_HOME"

    # A dry-run must NOT clobber the canonical interactive-profile.sh: a running
    # server's status/logs/restart commands read it.
    if [[ "$ACTION" == "command" ]]; then
        PROFILE_OUT="$(mktemp "$STATE_HOME/interactive-profile.dryrun.XXXXXX")"
    else
        PROFILE_OUT="$GENERATED_PROFILE"
    fi
    TEMP_PROFILE="$PROFILE_OUT.$$"
}

run_profile() {
    echo
    echo "Generated profile: $PROFILE_OUT"

    if [[ "$ACTION" == "command" ]]; then
        local status=0
        "$SCRIPT_DIR/llamactl" command --profile "$PROFILE_OUT" || status=$?
        rm -f "$PROFILE_OUT"
        return "$status"
    fi

    if ! "$SCRIPT_DIR/llamactl" restart --profile "$PROFILE_OUT"; then
        return 1
    fi

    # Keep Hermes' compaction trigger tied to the window this server actually
    # serves. Hermes has NO auto-detection for custom/OpenAI-compatible
    # providers -- it reads model.context_length out of ~/.hermes/config.yaml --
    # so switching presets otherwise leaves it compacting against the previous
    # window. Dropping to a SMALLER preset is the dangerous direction: the
    # trigger can land above the real window, so compaction never fires and
    # llama.cpp rejects the request instead. Non-fatal; no-ops when correct.
    if [[ -x "$SCRIPT_DIR/hermes-sync-ctx" ]]; then
        echo
        "$SCRIPT_DIR/hermes-sync-ctx" || true
    fi

    echo
    echo "── following live server log ── Ctrl-C detaches (server keeps running; 'llamakill' to stop) ──"
    exec "$SCRIPT_DIR/llamactl" logs
}

# Qwen3.8 27B's chat template takes a `reasoning_effort` kwarg and accepts ONLY
# xhigh/medium/low (it calls raise_exception on anything else, and silently
# remaps "high" to "xhigh"). No other model family here defines it, so the
# prompt is offered only when the chosen preset actually runs a Qwen3.8 27B.
profile_supports_reasoning_effort() {
    grep -q 'Qwen3\.8-27B' "$1" 2>/dev/null
}

profile_current_effort() {
    local lvl
    lvl=$(grep -m1 -oE '"reasoning_effort":"[a-z]+"' "$1" 2>/dev/null | cut -d'"' -f4)
    printf '%s\n' "${lvl:-xhigh (template default)}"
}

# Echoes a LLAMA_CHAT_TEMPLATE_KWARGS override line, or nothing to keep the
# profile's own setting. The override is merged into the profile's existing
# kwargs so flags like preserve_thinking survive.
prompt_reasoning_effort() {
    local profile="$1" choice effort
    profile_supports_reasoning_effort "$profile" || return 0

    echo >&2
    echo "Reasoning effort — Qwen3.8:" >&2
    echo "  1) xhigh  — deepest. Injects \"think carefully, validate key assumptions," >&2
    echo "              consider plausible alternatives\". Longest answers, slowest." >&2
    echo "  2) medium — injects nothing; the model's natural behavior." >&2
    echo "  3) low    — injects \"keep your thinking brief, move directly to the" >&2
    echo "              conclusion\". Shortest answers, fastest." >&2
    echo "  4) keep profile setting (currently: $(profile_current_effort "$profile"))" >&2
    choice="$(prompt_choice "Selection (1/2/3/4) [4]: ")"

    case "${choice:-4}" in
        1) effort="xhigh" ;;
        2) effort="medium" ;;
        3) effort="low" ;;
        4|"") return 0 ;;
        *) echo "Invalid reasoning selection." >&2; exit 2 ;;
    esac

    python3 - "$profile" "$effort" <<'PYEOF'
import json, re, sys
profile, effort = sys.argv[1], sys.argv[2]
m = re.search(r"^LLAMA_CHAT_TEMPLATE_KWARGS='(.*)'\s*$", open(profile).read(), re.M)
try:
    kwargs = json.loads(m.group(1)) if m else {}
except (AttributeError, ValueError):
    kwargs = {}
kwargs["reasoning_effort"] = effort
print("LLAMA_CHAT_TEMPLATE_KWARGS=" + repr(json.dumps(kwargs, separators=(",", ":"))))
PYEOF
}

echo "Launch mode:"
echo "  1) ROCm"
echo "  2) Vulkan"
echo "  3) Presets ROCm"
echo "  4) Presets Vulkan"
BACKEND_CHOICE="$(prompt_choice "Selection (1/2/3/4): ")"
case "$BACKEND_CHOICE" in
    1) BACKEND="rocm" ;;
    2) BACKEND="vulkan" ;;
    3|4)
        # One best-measured preset per model per backend, re-measured 2026-08-16
        # on the dual-GPU (7900 XTX + R9700) topology with f16 KV throughout.
        # Draft depth is NOT portable: it varies by model, by backend, AND by
        # topology -- Muse Glimmer wanted n-max 15 on a single GPU and wants 2 on
        # two, because spanning cards makes the verify pass expensive.
        # tg figures come from a fixed-seed harness; treat DFlash decode numbers
        # as +/-10% (DFlash is nondeterministic even at a fixed seed).
        # See docs/TUNING_QUEUE.md for the full evidence and open items.
        P="$LLAMA_SERVER_ROOT/config/profiles"
        if [[ "$BACKEND_CHOICE" == "3" ]]; then
            echo
            echo "Presets — ROCm:"
            echo "  split ratios: [L n,n]=layer [T n,n]=tensor (XTX,R9700; 1,1=auto)  vis=mmproj  txt=text-only"
            echo
            echo "  Qwen 3.6 35B-A3B MoE  Q8_0"
            echo "    1) vision      — MTP n2 — f16 — 256k   (2511 pp /  81.5 tg) [L 16,24 · vis]"
            echo "    2) text        — MTP n2 — f16 — 256k   (2538 pp /  83.2 tg) [L 16,24 · txt]"
            echo
            echo "  Qwen 3.8 27B dense — layer split"
            echo "    3) Q8_0 vision — MTP n3 — f16 — 245760 ( 509 pp@d65k / 34.4 tg) [L 1,1 · vis]"
            echo "    4) Q6_K vision — MTP n3 — f16 — 245760 ( 566 pp@d65k / 32.2 tg) [L 38,27 · vis]"
            echo "    5) Q6_K_P text — MTP n3 — f16 — 256k   (1208 pp /  34.5 tg) uncensored [L 34,31 · txt]"
            echo
            echo "  Qwen 3.8 27B dense — tensor split (long-context pp shown)"
            echo "    6) Q8_0 vision — MTP n3 — f16 — 245760 ( 275 pp@d65k / 44.8 tg; pp -46%) [T 45,55 · vis] ★"
            echo "    7) Q6_K vision — MTP n3 — f16 — 245760 ( 295 pp@d65k / 43.6 tg; pp -48%) [T 1,1 · vis]"
            echo "    8) Q6_K decode — MTP n3 — f16 — 192512 ( 415 pp / 49-54 tg, FASTEST DECODE) [T 58,42 · vis] ★"
            echo "    9) Q8_0 decode — MTP n3 — f16 — 131072 (29.4 raw / 45-48 tg MTP, fastest Q8) [T 58,42 · vis]"
            echo "   10) UD-Q6_K_XL  — MTP n3 — f16 — 262144 ( 435 pp / 30.3 tg raw, ROCm 10) [T 50,50 · vis] ★"
            echo
            echo "  Muse Glimmer 30B  Q8_0"
            echo "   11) 128k        — DFlash n2 — f16        ( 986 pp /  33.2 tg) [L 1,1 · txt]"
            echo "   12) 256k        — DFlash n2 — f16 — YaRN ( 891 pp /  34.1 tg, retrieval 3/3) [L 1,1 · txt]"
            echo
            PRESET_CHOICE="$(prompt_choice "Preset (1-12): ")"
            case "$PRESET_CHOICE" in
                1) PRESET_PROFILE="$P/preset-36-35b-a3b-q8-rocm-dual-q8-256k-mmproj.sh" ;;
                2) PRESET_PROFILE="$P/preset-36-35b-a3b-q8-rocm-dual-256k-textonly.sh" ;;
                3) PRESET_PROFILE="$P/preset-38-27b-q8-rocm-dual-q8-256k-mmproj.sh" ;;
                4) PRESET_PROFILE="$P/preset-38-27b-q6k-rocm-dual-f16-256k-mmproj.sh" ;;
                5) PRESET_PROFILE="$P/preset-38-27b-q6kp-hauhau-rocm-dual-f16-256k.sh" ;;
                6) PRESET_PROFILE="$P/preset-38-27b-q8-rocm-dual-f16-256k-mmproj-tensor-decode.sh" ;;
                7) PRESET_PROFILE="$P/preset-38-27b-q6k-rocm-dual-f16-256k-mmproj-tensor-decode.sh" ;;
                8) PRESET_PROFILE="$P/preset-38-27b-q6k-rocm-tensor-decode-58-42-188k.sh" ;;
                9) PRESET_PROFILE="$P/preset-38-27b-q8-rocm-tensor-decode-58-42-128k.sh" ;;
                10) PRESET_PROFILE="$P/preset-38-27b-udq6kxl-rocm-tensor-f16-256k.sh" ;;
                11) PRESET_PROFILE="$P/preset-muse-glimmer-30b-q8-rocm-dual-128k-dflash.sh" ;;
                12) PRESET_PROFILE="$P/preset-muse-glimmer-30b-q8-rocm-dual-256k-yarn.sh" ;;
                *) echo "Invalid preset selection." >&2; exit 2 ;;
            esac
        else
            echo
            echo "Presets — Vulkan:"
            echo "  split ratios: [L n,n]=layer [T n,n]=tensor (XTX,R9700; 1,1=auto)  vis=mmproj  txt=text-only"
            echo
            echo "  Qwen 3.6 35B-A3B MoE  Q8_0"
            echo "    1) vision              — MTP n2 — f16  — 256k   (2072 pp /  93.7 tg) [L 18,22 · vis]"
            echo "    2) text                — MTP n2 — f16  — 256k   (2129 pp /  94.0 tg) [L 18,22 · txt]"
            echo
            echo "  Qwen 3.8 27B dense — Q8_0"
            echo "    3) layer, vision       — MTP n3 — f16  — 256k   ( 825 pp /  35.0 tg) [L 28,37 · vis]"
            echo "    4) tensor, decode      — MTP n3 — f16  — 216k   ( 947 pp /  40.3 tg, 2x prefill) [T 50,50 · vis]"
            echo "    5) tensor, full ctx    — MTP n3 — f16  — 256k   (~19 tg raw, text-only) [T 49,51 · txt]"
            echo "    6) tensor + adaptive   — MTP    — f16  — 256k   ( 809 pp /  50.9 tg) [T 49,51 · vis] ★"
            echo
            echo "  Qwen 3.8 27B dense — Q6_K (unsloth)"
            echo "    7) tensor, decode      — MTP n3 — q8_0 — 192k   ( 697 pp / 28.65 tg unspec) [T 70,30 · vis]"
            echo "    8) tensor, decode      — MTP n3 — f16  — 144k   ( 718 pp / 28.37 tg unspec) [T 68,32 · vis]"
            echo "    9) tensor, full ctx    — MTP n3 — f16  — 256k   ( 889 pp / 23.17 tg unspec) [T 50,50 · vis]"
            echo
            echo "  Qwen 3.8 27B dense — UD-Q6_K_XL (unsloth Dynamic v3.0)"
            echo "   10) tensor, full ctx    — MTP n3 — f16  — 262144 ( 934 pp / 25.4 tg raw; 585/23.1 @d65k) [T 50,50 · vis] ★"
            echo
            echo "  Muse Glimmer 30B  Q8_0"
            echo "   11) layer              — DFlash n2 — f16 — 128k  ( 743 pp /  31.7 tg; prefer ROCm) [L 1,1 · txt]"
              echo
              echo "  Qwen3.8-Flash-Next 125B-A6B  UD-IQ3_XXS (n-gram table on CPU)"
              echo "   12) layer              — no spec  — q8_0 — 81920  ( 688 pp / 42.5 tg; 29.2 @d9k) [L 385,615 · txt] ★NEW"
            echo
            PRESET_CHOICE="$(prompt_choice "Preset (1-12): ")"
            case "$PRESET_CHOICE" in
                1) PRESET_PROFILE="$P/preset-36-35b-a3b-q8-vulkan-dual-q8-256k-mmproj.sh" ;;
                2) PRESET_PROFILE="$P/preset-36-35b-a3b-q8-vulkan-dual-256k-textonly.sh" ;;
                3) PRESET_PROFILE="$P/preset-38-27b-q8-vulkan-dual-q8-256k-mmproj.sh" ;;
                4) PRESET_PROFILE="$P/preset-38-27b-q8-vulkan-tensor-decode-200k.sh" ;;
                5) PRESET_PROFILE="$P/preset-38-27b-q8-vulkan-tensor-full-256k-f16.sh" ;;
                6) PRESET_PROFILE="$P/preset-38-27b-q8-vulkan-tensor-adaptive-256k-f16.sh" ;;
                7) PRESET_PROFILE="$P/preset-38-27b-q6k-vulkan-tensor-decode-192k.sh" ;;
                8) PRESET_PROFILE="$P/preset-38-27b-q6k-vulkan-tensor-decode-f16-144k.sh" ;;
                9) PRESET_PROFILE="$P/preset-38-27b-q6k-vulkan-tensor-256k.sh" ;;
                10) PRESET_PROFILE="$P/preset-38-27b-udq6kxl-vulkan-tensor-f16-256k.sh" ;;
                11) PRESET_PROFILE="$P/preset-muse-glimmer-30b-q8-vulkan-dual-128k-dflash.sh" ;;
                12) PRESET_PROFILE="$P/preset-flashnext-iq3xxs-vulkan-layer-82k.sh" ;;
                *) echo "Invalid preset selection." >&2; exit 2 ;;
            esac
        fi

        REASONING_OVERRIDE="$(prompt_reasoning_effort "$PRESET_PROFILE")"

        prepare_profile_output
        {
            printf '# Generated by %s\n' "$0"
            printf 'source %q\n' "$PRESET_PROFILE"
            [[ -n "$REASONING_OVERRIDE" ]] && printf '%s\n' "$REASONING_OVERRIDE"
        } > "$TEMP_PROFILE"
        mv "$TEMP_PROFILE" "$PROFILE_OUT"
        run_profile
        exit $?
        ;;
    *) echo "Invalid launch-mode selection." >&2; exit 2 ;;
esac

echo
echo "Model:"
echo "  1) Qwen 3.6 35B-A3B MoE MTP, Q8_0            [SINGLE-GPU on Vulkan; ROCm=all, no split]"
echo "  2) Qwen 3.8 27B MTP, Q8_0 (vision)           [L 1,1 ROCm / L 9,11 Vulkan]"
echo "  3) Qwen 3.8 27B MTP, Q6_K (vision)           [L 1,1 ROCm / L 9,11 Vulkan]"
echo "  4) Qwen 3.8 27B Q6_K_P HauhauCS unc. (no vision) [L 1,1 ROCm / L 9,11 Vulkan]"
echo "  5) Muse Glimmer 30B, Q8_0 (DFlash sidecar)   [SINGLE-GPU on Vulkan; ROCm=all, no split]"
MODEL_CHOICE="$(prompt_choice "Selection (1/2/3/4/5): ")"
case "$MODEL_CHOICE" in
    1)
        MODEL="$MODELS_DIR/Qwen3.6-35B-A3B-Q8_0.gguf"
        ARCH="moe"; HAS_MTP=1
        ;;
    2)
        MODEL="$MODELS_DIR/Qwen3.8-27B-Q8_0.gguf"
        ARCH="qwen38-27b"; HAS_MTP=1
        ;;
    3)
        MODEL="$MODELS_DIR/Qwen3.8-27B-Q6_K.gguf"
        ARCH="qwen38-27b"; HAS_MTP=1
        ;;
    4)
        MODEL="$MODELS_DIR/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q6_K_P.gguf"
        ARCH="qwen38-27b"; HAS_MTP=1
        ;;
    5)
        MODEL="$MODELS_DIR/Muse-Glimmer-30B-Q8_0.gguf"
        ARCH="muse-glimmer"; HAS_MTP=0
        ;;
    *) echo "Invalid model selection." >&2; exit 2 ;;
esac

CTX_K="$(prompt_choice "Context size in Ki tokens (for example 128 or 255): ")"
[[ "$CTX_K" =~ ^[1-9][0-9]*$ ]] || { echo "Context must be a positive integer." >&2; exit 2; }
CONTEXT=$((CTX_K * 1024))

# The old *-dflash-IQ4_XS.gguf drafters declare arch 'dflash-draft', which NO
# current engine loads ("unknown model architecture"). Replaced 2026-08-11 with
# current-format 'dflash' sidecars from the Anbeeld repos.
# Only Muse Glimmer needs a DFlash sidecar: it has no MTP head. Every other
# model here carries built-in MTP (nextn_predict_layers=1), so the old Qwen
# DFlash sidecars were deleted along with the Q4/IQ4 quants and referencing them
# made the custom path fail on a missing file.
if [[ "$ARCH" == "muse-glimmer" ]]; then
    DRAFTER="$MODELS_DIR/dflash-kquant.gguf"
else
    DRAFTER=""
fi

# ── Decision tree: each step narrows the next; the binary is DERIVED last so a
# ── later choice can never contradict an earlier one.
#   speculation  is a property of the model: MTP models always run MTP; non-MTP
#                models may use DFlash or none.
#   KV cache     options then follow from the speculation choice (q5_0/q4_0 only
#                exist for plain base modes on Vulkan).
#   binary       Everything runs on mainline (10358): it serves qwen35/qwen35moe
#                MTP AND DFlash on both backends, plus Muse Glimmer DFlash.
#                Benchmarked 2026-08-11: BeeLlama and mainline were within 0.4%
#                on MoE MTP decode (206.0 vs 204.9 t/s); the BeeLlama v0.3.2
#                tree was removed 2026-08-16 (KVarN superseded by f16 KV).
#                See docs/QWEN36_SPECULATION_BACKEND_AUDIT.md.
SPEC_MODE="none"
DRAFT_TYPE_K=""
DRAFT_TYPE_V=""

echo
if [[ "$HAS_MTP" == "1" ]]; then
    SPEC_MODE="mtp"
    echo "Speculation: MTP (engaged — model is MTP-capable)"
elif [[ "$BACKEND" == "rocm" && "$ARCH" != "muse-glimmer" ]]; then
    echo "Speculation:"
    echo "  1) DFlash"
    echo "  2) None"
    SPEC_CHOICE="$(prompt_choice "Selection (1/2): ")"
    case "$SPEC_CHOICE" in
        1) SPEC_MODE="dflash" ;;
        2) SPEC_MODE="none" ;;
        *) echo "Invalid speculation selection." >&2; exit 2 ;;
    esac
elif [[ "$ARCH" == "muse-glimmer" ]]; then
    echo "Speculation:"
    echo "  1) DFlash (16-token block drafter)"
    echo "  2) None"
    SPEC_CHOICE="$(prompt_choice "Selection (1/2): ")"
    case "$SPEC_CHOICE" in
        1) SPEC_MODE="dflash" ;;
        2) SPEC_MODE="none" ;;
        *) echo "Invalid speculation selection." >&2; exit 2 ;;
    esac
else
    SPEC_MODE="none"
fi

echo
echo "KV cache:"
# KVarN removed 2026-08-09: on Vulkan/gfx1100 it is ~47% slower on encode and
# ~42% on decode than q8_0 for ~1.6 GiB saved. q5_1 saves 1.25 GiB at full speed.
# See beellama.cpp issue #112. Note q6_0/q6_1/q3_*/q2_* are NOT in Vulkan's
# fa_kv_ok() whitelist and silently fall off FlashAttention (~10x slower).
if [[ "$SPEC_MODE" == "none" && "$BACKEND" == "vulkan" ]]; then
    echo "  1) q8_0"
    echo "  2) q5_1  (1.25 GiB smaller, same speed)"
    echo "  3) q5_0"
    echo "  4) q4_0"
    KV_CHOICE="$(prompt_choice "Selection (1-4): ")"
    case "$KV_CHOICE" in
        1) CACHE_K="q8_0"; CACHE_V="q8_0" ;;
        2) CACHE_K="q5_1"; CACHE_V="q5_1" ;;
        3) CACHE_K="q5_0"; CACHE_V="q5_0" ;;
        4) CACHE_K="q4_0"; CACHE_V="q4_0" ;;
        *) echo "Invalid KV cache selection." >&2; exit 2 ;;
    esac
else
    echo "  1) q8_0"
    echo "  2) q5_1  (1.25 GiB smaller, same speed)"
    KV_CHOICE="$(prompt_choice "Selection (1/2): ")"
    case "$KV_CHOICE" in
        1) CACHE_K="q8_0"; CACHE_V="q8_0" ;;
        2) CACHE_K="q5_1"; CACHE_V="q5_1" ;;
        *) echo "Invalid KV cache selection." >&2; exit 2 ;;
    esac
fi

[[ "$BACKEND" == "vulkan" ]] && BINARY="$BIN_VULKAN" || BINARY="$BIN_MAINLINE"

# Vulkan MTP draft KV defaults to f16, which overflows VRAM at high context; pin q8_0.
if [[ "$SPEC_MODE" == "mtp" && "$BACKEND" == "vulkan" ]]; then
    DRAFT_TYPE_K="q8_0"; DRAFT_TYPE_V="q8_0"
fi

# MTP-only: let the user choose the max draft tokens per step (--spec-draft-n-max).
# Leave empty for non-MTP modes so the profile inherits default.sh's value.
SPEC_DRAFT_N_MAX=""
NAME_SPEC="$SPEC_MODE"
if [[ "$SPEC_MODE" == "mtp" ]]; then
    echo
    DRAFT_N_MAX_INPUT="$(prompt_choice "Max draft tokens per step (MTP n-max) [default 2]: ")"
    SPEC_DRAFT_N_MAX="${DRAFT_N_MAX_INPUT:-2}"
    [[ "$SPEC_DRAFT_N_MAX" =~ ^[1-9][0-9]*$ ]] ||
        { echo "Max draft tokens must be a positive integer." >&2; exit 2; }
    NAME_SPEC="mtp-n${SPEC_DRAFT_N_MAX}"
elif [[ "$SPEC_MODE" == "dflash" && "$ARCH" == "muse-glimmer" ]]; then
    SPEC_DRAFT_N_MAX=15
    SPEC_DRAFT_N_MIN=0
    NAME_SPEC="dflash-n${SPEC_DRAFT_N_MAX}"
fi

prepare_profile_output
{
    printf '# Generated by %s\n' "$0"
    printf 'source %q\n' "$DEFAULT_PROFILE"
    printf 'PROFILE_NAME=%q\n' "interactive-${ARCH}-${BACKEND}-${CACHE_K}-${NAME_SPEC}-${CTX_K}k"
    printf 'LLAMA_BINARY=%q\n' "$BINARY"
    printf 'LLAMA_MODEL=%q\n' "$MODEL"
    printf 'LLAMA_BACKEND=%q\n' "$BACKEND"
    if [[ "$BACKEND" == "vulkan" ]]; then
        if [[ "$ARCH" == "qwen38-27b" ]]; then
            printf 'LLAMA_DEVICE=%q\n' "Vulkan0,Vulkan1"
        else
            printf 'LLAMA_DEVICE=%q\n' "Vulkan0"
        fi
    elif [[ "$ARCH" == "qwen38-27b" ]]; then
        printf 'LLAMA_DEVICE=%q\n' "ROCm0,ROCm1"
    else
        printf 'LLAMA_DEVICE=%q\n' ""
    fi
    printf 'LLAMA_CONTEXT=%q\n' "$CONTEXT"
    printf 'LLAMA_CACHE_TYPE_K=%q\n' "$CACHE_K"
    printf 'LLAMA_CACHE_TYPE_V=%q\n' "$CACHE_V"
    printf 'LLAMA_SPEC_MODE=%q\n' "$SPEC_MODE"
    printf 'LLAMA_DRAFTER=%q\n' "$DRAFTER"
    printf 'LLAMA_SPEC_DRAFT_TYPE_K=%q\n' "$DRAFT_TYPE_K"
    printf 'LLAMA_SPEC_DRAFT_TYPE_V=%q\n' "$DRAFT_TYPE_V"
    if [[ "$ARCH" == "qwen38-27b" ]]; then
        printf 'LLAMA_UBATCH=%q\n' "512"
        printf 'LLAMA_CACHE_RAM=%q\n' ""
        printf 'LLAMA_TEMPERATURE=%q\n' "1.0"
        printf 'LLAMA_TOP_P=%q\n' "0.95"
        printf 'LLAMA_TOP_K=%q\n' "20"
        printf 'LLAMA_MIN_P=%q\n' "0.0"
        printf 'LLAMA_PRESENCE_PENALTY=%q\n' "0.0"
        printf 'LLAMA_REPEAT_PENALTY=%q\n' "1.0"
        if [[ "$BACKEND" == "rocm" ]]; then
            printf 'export HIP_VISIBLE_DEVICES=0,1\n'
            printf 'LLAMA_EXTRA_ARGS=(--device ROCm0,ROCm1 --split-mode layer --tensor-split 1,1 --main-gpu 1 --batch-size 2048 --no-mmap --mmproj %q --reasoning-preserve)\n' "$MODELS_DIR/mmproj-BF16.gguf"
        else
            printf 'LLAMA_EXTRA_ARGS=(--split-mode layer --tensor-split 9,11 --batch-size 2048 --no-mmap --mmproj %q --reasoning-preserve)\n' "$MODELS_DIR/mmproj-BF16.gguf"
        fi
    elif [[ "$ARCH" == "muse-glimmer" ]]; then
        printf 'LLAMA_CONTEXT_SHIFT=%q\n' "1"
        printf 'LLAMA_TEMPERATURE=%q\n' "0.7"
        printf 'LLAMA_TOP_P=%q\n' "1.0"
        printf 'LLAMA_REASONING=%q\n' "auto"
        printf 'LLAMA_CHAT_TEMPLATE_KWARGS=%q\n' ""
        printf 'LLAMA_CACHE_RAM=%q\n' ""
        if [[ "$SPEC_MODE" == "dflash" ]]; then
            printf 'LLAMA_DFLASH_SPEC_TYPE=%q\n' "draft-dflash"
            printf 'LLAMA_SPEC_DFLASH_CROSS_CTX=%q\n' ""
        fi
    fi
    if [[ -n "$SPEC_DRAFT_N_MAX" ]]; then
        printf 'LLAMA_SPEC_DRAFT_N_MAX=%q\n' "$SPEC_DRAFT_N_MAX"
    fi
    if [[ -n "${SPEC_DRAFT_N_MIN:-}" ]]; then
        printf 'LLAMA_SPEC_DRAFT_N_MIN=%q\n' "$SPEC_DRAFT_N_MIN"
    fi
} > "$TEMP_PROFILE"
mv "$TEMP_PROFILE" "$PROFILE_OUT"

run_profile
